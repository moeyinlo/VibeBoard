<Window x:Class="VibeBoardPlus.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeBoard Plus 设置" Width="620" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FFF6F6F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">
            <TabItem Header="识别输出">
                <StackPanel Margin="16">
                    <TextBlock Text="输出方式" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="OutputModeCombo" Width="320" HorizontalAlignment="Left" />
                    <TextBlock Text="实时输入会直接写进当前输入框；完成后粘贴会模拟 Ctrl+V；仅悬浮窗只显示结果。"
                               TextWrapping="Wrap" Foreground="#FF666666" FontSize="12" Margin="0,6,0,0" />
                    <CheckBox x:Name="AutoCopyCheck" Content="完成后自动复制到剪贴板" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="设备按键">
                <StackPanel Margin="16" x:Name="ButtonPanel">
                    <TextBlock Text="每个按键对应一个动作" FontWeight="SemiBold" Margin="0,0,0,10" />
                </StackPanel>
            </TabItem>

            <TabItem Header="语音识别">
                <StackPanel Margin="16">
                    <TextBlock Text="识别服务" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="ProviderCombo" Width="320" HorizontalAlignment="Left" />

                    <TextBlock Text="本地 Whisper 模型" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="WhisperModelCombo" Width="180" />
                        <Button x:Name="DownloadButton" Content="下载模型" Width="96" Margin="10,0,0,0" Click="OnDownloadModel" />
                    </StackPanel>
                    <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="WhisperStatusText" Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="EngineText" Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock x:Name="StatsText" Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="StepFun 云端" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ComboBox x:Name="AsrModelCombo" Width="320" HorizontalAlignment="Left" />
                    <PasswordBox x:Name="RecognitionKeyBox" Width="320" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Text="留空表示沿用已保存的密钥；云端整理默认复用这个 Key。" Foreground="#FF666666" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="语义整理">
                <StackPanel Margin="16">
                    <CheckBox x:Name="RewriteCheck" Content="识别完成后用云端做轻度整理（纠错、补标点、去口头语）" />
                    <TextBlock Text="整理模型" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <TextBox x:Name="RewriteModelBox" Width="320" HorizontalAlignment="Left" />
                    <TextBlock Text="单独的 StepFun Key（留空则复用识别 Key）" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <PasswordBox x:Name="RewriteKeyBox" Width="320" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem Header="关于 / 诊断">
                <StackPanel Margin="16">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="SystemInfoText" Foreground="#FF666666" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Button Content="打开日志" Width="96" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnOpenLog" />
                    <TextBlock x:Name="SaveStatusText" Foreground="#FF0A7A3D" FontSize="12" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Width="96" Click="OnSave" />
            <Button Content="关闭" Width="96" Margin="10,0,0,0" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
